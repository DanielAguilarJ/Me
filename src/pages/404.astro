---
import Base from '../layouts/Base.astro';
---

<Base lang="es" title="404 · Daniel Junco" noindex preloadOutline={false}>
  <main class="notfound">
    <p class="notfound__code">404</p>
    <h1 class="notfound__title">Esta página se perdió en el espacio.</h1>
    <p class="notfound__text" lang="en">This page drifted off into space.</p>
    <div class="notfound__links">
      <a class="btn btn--primary" href="/">Volver al inicio</a>
      <a class="btn btn--ghost" href="/en/" lang="en">Back to home</a>
    </div>
  </main>
</Base>
