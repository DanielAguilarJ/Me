---
interface Props {
  index: string;
  label: string;
  title: string;
  id: string;
  level?: 'h2' | 'h3';
}
const { index, label, title, id, level = 'h2' } = Astro.props;
const Tag = level;
---

<header class="section-head">
  <p class="eyebrow" data-reveal>
    <span class="eyebrow__index">[{index}]</span>
    <span class="eyebrow__line" aria-hidden="true"></span>
    <span>{label}</span>
  </p>
  <Tag class="title" id={id} data-split set:html={title} />
</header>
