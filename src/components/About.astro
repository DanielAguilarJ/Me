---
import type { Content } from '../data/content';
import SectionHead from './SectionHead.astro';

interface Props {
  t: Content;
}
const { t } = Astro.props;
const a = t.about;
---

<section class="section about" id="about" data-scene="about" aria-labelledby="about-title">
  <div class="section__col panel">
    <SectionHead index={a.index} label={a.label} title={a.title} id="about-title" />
    <div class="about__text">
      {a.paragraphs.map((p, i) => <p class={i === 0 ? 'lead' : ''} data-reveal>{p}</p>)}
    </div>
    <ul class="stats">
      {
        a.stats.map((s) => (
          <li class="stat" data-reveal>
            <span class="stat__value">
              <span data-count={s.value}>{s.value}</span>
              {s.suffix}
            </span>
            <span class="stat__label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
